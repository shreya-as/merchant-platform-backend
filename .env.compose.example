# Copy to .env (gitignored) in the project root. docker compose reads it automatically, and the
# e2e tests read the same secrets from it. Never commit the real .env.
#
#   cp .env.compose.example .env
#   sed -i "s|<jwt-secret>|$(openssl rand -base64 48)|; s|<db-password>|$(openssl rand -hex 16)|; s|<seed-password>|$(openssl rand -base64 12)|" .env

DB_USER=postgres
DB_PASSWORD=<db-password>
JWT_SECRET=<jwt-secret>

# Password for the demo users (admin@ / reviewer@ / sales@merchantplatform.com) seeded on start.
SEED_USER_PASSWORD=<seed-password>

# Seeds demo users on container start. Set to false for anything other than a local stack.
SEED_ON_START=true

# Optional host port overrides
# POSTGRES_HOST_PORT=5433
# REDIS_HOST_PORT=6380
# API_HOST_PORT=3000
