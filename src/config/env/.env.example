# Copy to src/config/env/.env.local (gitignored) and fill in the <...> values.
# Never commit real values. Generate secrets with: openssl rand -base64 48
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1

# Swagger UI at /docs, OpenAPI JSON at /docs-json
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# Database Configuration (with docker compose: DB_PORT=5433 and the values from the root .env)
DB_HOST=localhost
DB_PORT=5432
DB_USER=<db-user>
DB_PASSWORD=<db-password>
DB_NAME=merchant_platform

# Redis Configuration (with docker compose: REDIS_PORT=6380)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# JWT Auth Configuration. Required, at least 32 characters, no default.
JWT_SECRET=<generate-with-openssl-rand-base64-48>
JWT_EXPIRES_IN=1d

# Password for the demo users created by `pnpm seed`. If unset, a random one is generated and printed.
SEED_USER_PASSWORD=<choose-a-local-demo-password>

# Risk review queue (BullMQ)
BULLMQ_RETRY_ATTEMPTS=3
BULLMQ_BACKOFF_DELAY_MS=2000

# Simulated KYB / risk provider
RISK_PASS_THRESHOLD=70
RISK_SIMULATED_LATENCY_MS=800
# 0..1 share of calls that fail transiently, to see retries with backoff in action
RISK_TRANSIENT_FAILURE_RATE=0
