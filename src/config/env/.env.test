# Used by `pnpm test:e2e` (NODE_ENV=test). Targets the docker compose Postgres/Redis on their
# default host ports, in a separate database and Redis DB so dev data is never touched.
# Any variable already set in the shell wins over this file.
# Secrets (DB_USER, DB_PASSWORD, JWT_SECRET, SEED_USER_PASSWORD) are NOT here: they come from the
# gitignored root .env shared with docker compose (see test/setup/load-env.ts).
PORT=3000
NODE_ENV=test

DB_HOST=localhost
DB_PORT=5433
DB_NAME=merchant_platform_test

REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=1

JWT_EXPIRES_IN=15m
BCRYPT_SALT_ROUNDS=4

# Fast, deterministic risk processing; tests inject failures explicitly.
BULLMQ_RETRY_ATTEMPTS=2
BULLMQ_BACKOFF_DELAY_MS=50
RISK_SIMULATED_LATENCY_MS=0
RISK_TRANSIENT_FAILURE_RATE=0
